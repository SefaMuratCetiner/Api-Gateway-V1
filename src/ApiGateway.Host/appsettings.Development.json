{
  "Observability": {
    "Tracing": {
      "TrustMode": "Always",
      "SamplingRatio": 1.0
    },
    "ClientIp": {
      "Mode": "None"
    },
    "AccessLog": {
      "IncludeQueryString": true
    },
    "Export": {
      "PrometheusEnabled": true
    },
    "Logging": {
      "MinimumLevel": "Debug",
      "Console": {
        "Format": "Text"
      }
    }
  }
}
