{
  "Observability": {
    "Tracing": {
      "TrustMode": "TrustedNetworks",
      "SamplingRatio": 0.1,
      "SlowThreshold": "00:00:01.500"
    },
    "ClientIp": {
      "Mode": "Truncate"
    },
    "AccessLog": {
      "IncludeQueryString": false
    },
    "Export": {
      "OtlpEndpoint": "http://otel-collector:4317",
      "OtlpProtocol": "Grpc"
    },
    "Logging": {
      "MinimumLevel": "Information",
      "Console": {
        "Format": "Json"
      },
      "File": {
        "Enabled": true,
        "Path": "/var/log/api-gateway/gateway-.json",
        "RetainedDays": 14,
        "RetainedFileCountLimit": 31
      },
      "Otlp": {
        "Enabled": true
      },
      "Audit": {
        "Path": "/var/log/api-gateway/audit/audit-.json",
        "RetainedDays": 400
      },
      "Usage": {
        "Path": "/var/log/api-gateway/usage/usage-.json",
        "RetainedDays": 90
      }
    }
  }
}
